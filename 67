-- ปุ่มเปิด/ปิดฟังก์ชัน (Toggle Switch)
--------------------------------------------------------
local function createToggle(parent, labelText, defaultState, callback)
    local Frame = Instance.new("Frame")
    Frame.Parent = parent
    Frame.Size = UDim2.new(1, -10, 0, 34)
    Frame.BackgroundColor3 = Color3.fromRGB(28, 28, 35)

    local FrameCorner = Instance.new("UICorner", Frame)
    FrameCorner.CornerRadius = UDim.new(0, 6)

    local Label = Instance.new("TextLabel")
    Label.Parent = Frame
    Label.BackgroundTransparency = 1
    Label.Position = UDim2.new(0, 10, 0, 0)
    Label.Size = UDim2.new(0, 200, 1, 0)
    Label.Font = Enum.Font.SourceSans
    Label.Text = labelText
    Label.TextColor3 = Color3.fromRGB(230, 230, 230)
    Label.TextSize = 13
    Label.TextXAlignment = Enum.TextXAlignment.Left

    local Switch = Instance.new("TextButton")
    Switch.Parent = Frame
    Switch.Position = UDim2.new(1, -45, 0.5, -9)
    Switch.Size = UDim2.new(0, 36, 0, 18)
    Switch.BackgroundColor3 = defaultState and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(55, 55, 65)
    Switch.Text = ""

    local SwitchCorner = Instance.new("UICorner", Switch)
    SwitchCorner.CornerRadius = UDim.new(1, 0)

    local toggleData = {Object = Switch, State = defaultState}
    table.insert(rainbowElements, toggleData)

    Switch.MouseButton1Click:Connect(function()
        toggleData.State = not toggleData.State
        if not toggleData.State then
            Switch.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
        end
        callback(toggleData.State)
    end)
end

