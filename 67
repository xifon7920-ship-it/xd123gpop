-- ระบบแท็บเมนู
--------------------------------------------------------
local tabs = {}

local function createTab(tabName)
    local Page = Instance.new("ScrollingFrame")
    Page.Parent = Container
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.BackgroundTransparency = 1
    Page.ScrollBarThickness = 3
    Page.Visible = false

    local PageLayout = Instance.new("UIListLayout", Page)
    PageLayout.Padding = UDim.new(0, 6)

    local TabBtn = Instance.new("TextButton")
    TabBtn.Parent = Sidebar
    TabBtn.Size = UDim2.new(0.9, 0, 0, 35)
    TabBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
    TabBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    TabBtn.Font = Enum.Font.SourceSansBold
    TabBtn.TextSize = 13
    TabBtn.Text = tabName

    local TabCorner = Instance.new("UICorner", TabBtn)
    TabCorner.CornerRadius = UDim.new(0, 6)

    local tabData = {Page = Page, Btn = TabBtn, Object = TabBtn, State = false}
    table.insert(rainbowElements, tabData)

    TabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do
            t.Page.Visible = false
            t.State = false
            t.Btn.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
            t.Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
        Page.Visible = true
        tabData.State = true
        TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)

    tabs[tabName] = tabData
    return Page
end

