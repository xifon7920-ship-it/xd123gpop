-- 🌈 ระบบเปลี่ยนสีสายรุ้ง (Rainbow Effect)
--------------------------------------------------------
local rainbowElements = {}

RunService.RenderStepped:Connect(function()
    local hue = (tick() % 3) / 3
    local rainbowColor = Color3.fromHSV(hue, 0.8, 1)
    
    RainbowStroke.Color = rainbowColor
    ToggleBtnStroke.Color = rainbowColor
    Title.TextColor3 = rainbowColor
    
    for _, elem in pairs(rainbowElements) do
        if elem.State then
            elem.Object.BackgroundColor3 = rainbowColor
        end
    end
end)

